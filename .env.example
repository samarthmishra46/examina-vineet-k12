# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=your-nextauth-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://...

# ── AI / TTS ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Storage ───────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── HeyGen Avatar (optional) ──────────────────────────────────────────────────
HEYGEN_API_KEY=
NEXT_PUBLIC_HEYGEN_AVATAR_ID=
NEXT_PUBLIC_HEYGEN_VOICE_ID=

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get test keys from: https://dashboard.razorpay.com/app/keys
# Test key IDs start with rzp_test_, live with rzp_live_
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX  # same as RAZORPAY_KEY_ID

# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Plan ID — create once in Razorpay Dashboard → Products → Plans
# Amount: 99900 paise (₹999), Period: monthly, Interval: 1
RAZORPAY_PLAN_ID=plan_XXXXXXXXXXXXXXXX
