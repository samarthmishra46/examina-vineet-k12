{
  "name": "examina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:smoke": "dotenv -e .env.local -- tsx scripts/db-smoke.ts",
    "db:fix-indexes": "dotenv -e .env.local -- tsx scripts/fix-progress-indexes.ts",
    "lesson:smoke": "dotenv -e .env.local -- tsx scripts/lesson-smoke.ts",
    "deploy": "git push origin main"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@auth/mongodb-adapter": "^3.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@heygen/liveavatar-web-sdk": "^0.0.18",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@vercel/blob": "^2.4.0",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "mongodb": "^6.21.0",
    "mongoose": "^9.6.2",
    "next": "^14.2.18",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.38.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.2",
    "typescript": "^5.6.3"
  }
